# Copy to .env.playwright (git-ignored) for local e2e runs, or set these as
# GitHub Actions secrets for CI. Values must match an environment seeded by
# `node scripts/seed-test-accounts.mjs` (requires CI_TEACHER_PASSWORD set).

BASE_URL=https://your-app.vercel.app

CI_TEACHER_EMAIL=ci-teacher@keenkids.test
CI_TEACHER_PASSWORD=
CI_CLASSROOM_CODE=CITEST
CI_STUDENT_LASTNAME=Student
CI_STUDENT_PIN=9999

# UUID of a Week 3 scratch coding day in the CI classroom.
# Find it with: SELECT id FROM curriculum_content WHERE language = 'scratch' LIMIT 1;
CI_SCRATCH_DAY_ID=

# UUID of a science content item in the CI classroom (for smoke.spec.ts).
# Find it with:
#   SELECT ci.id FROM content_items ci
#   JOIN curriculum_content cc ON cc.content_item_id = ci.id
#   JOIN curriculum_days cd ON cd.id = cc.curriculum_day_id
#   WHERE ci.subject = 'science' LIMIT 1;
CI_SCIENCE_CONTENT_ID=

# UUID of a build curriculum_days row in the CI classroom (for smoke.spec.ts).
# Find it with:
#   SELECT cd.id FROM curriculum_days cd WHERE cd.subject = 'build' LIMIT 1;
CI_BUILD_DAY_ID=
